  Copyright 2023 Alex Maestas. (Read the LICENSE for details.)

loading Fibonacci LED main program

__meta
decimal

48 dup
   buffer even-fb
   buffer odd-fb

ram
here 16 aligned-by goto ( dma buffers must be properly aligned)
flash

32 dup buffer dma-descriptor
       buffer dma-writeback

variable state
variable onboard-color
variable dmac-ints
( variable tcc1-flags)
( 24 dup buffer strand-colors
         buffer strand-next-colors)
( for later: 24 buffer onboard-fb)

: state! ( a -- )
  state ! ;

ld! target/ARM/microchip/hardware-primitives.mu4
ld! target/ARM/microchip/samd21-clocks.mu4
ld! target/ARM/microchip/samd21-tcc.mu4

: led-ports-init
  32 0 do $40 i PORT_PINCFG0_0 + c! loop ( set strong drive on all output pins)
  $40 state!
  [ 10 pin  ( MO pin to 128-LED strand)
    18 pin| ( neopixel pin)
    15 pin| ( neopixel power)
    16 pin| ( copy of neopixel pin from TCC0 channel 6)
    11 pin| ( gclk5 out, tapped from gclk0)
  #] dup PORT_DIRSET0 ! ( set these pins as outputs)
  $41 state!
  PORT_OUTCLR0 ! ( turn everything off)
  $42 state!
  [ 15 pin #] PORT_OUTSET0 ! ( turn neopixel power on) ;

: pmux-init
  PMUX_ODD_FUNCTION_H  11 mux-pin   ( pin PA11 to function H, GCLK channel 5)
  PMUX_EVEN_FUNCTION_F 16 mux-pin   ( pin PA16 to function F, TCC0 channel 6)
  PMUX_EVEN_FUNCTION_F 18 mux-pin   ( pin PA18 to function F, TCC0 channel 2)
  PMUX_EVEN_FUNCTION_E 10 mux-pin ; ( pin PA10 to function E, TCC1 channel 0)

: onboard-to-fb ( -- )
  onboard-color @
  24 0 do
    dup $0080:0000 and 0= if T0H else T1H then
    even-fb i 2* + h!
    2*
  loop
  drop ;

: flags>descr           h! ; ( f desc --)
: btcnt>descr        2+ h! ; ( ditto)
:  src@>descr     cell+  ! ;
: dest@>descr 2 cells +  ! ;
: next@>descr 3 cells +  ! ;

: onboard-dma-descr-init ( descr -- descr)
  >r
  [ 1 ( valid)
    1  3 << or ( blockact interrupt)
    1 10 << or ( source increment)
  #] r@ flags>descr
  24 r@ btcnt>descr ( 24 bytes to transfer)
  even-fb 24 + r@ src@>descr ( point to the end of the buffer, because that's where you have to point)
  0 tcc-to-ccb r@ dest@>descr ( write to TCC0's CCB)
  r> ;

: dmac-init
  ( reset the thing)
  [ DMAC_CTRL_DMAENABLE DMAC_CTRL_CRCENABLE or #] DMAC_CTRL 2dup h!
  swap ?cclr ( sync on disable)
  $20 state!

  DMAC_CTRL_SWRST DMAC_CTRL 2dup c!
  swap ?cclr ( sync on reset)
  $21 state!

  [ DMAC_CTRL_LVLEN0
    DMAC_CTRL_LVLEN1 or
    DMAC_CTRL_LVLEN2 or
    DMAC_CTRL_LVLEN3 or
  #] DMAC_CTRL c! ( enable all priorities)
  $22 state!

  dma-writeback DMAC_WRBADDR !
  dma-descriptor onboard-dma-descr-init DMAC_BASEADDR !
  $23 state!

  ( set up channel 0 to beat to the timer)
  0 DMAC_CHID c!
  [ $02 22 <<   ( one beat per trigger)
    $0D 8 << or ( trigger on TCC0 overflow)
  #] DMAC_CHCTRLB !
  $24 state!

  DMAC_IRQ nvic-enable-irq
  $25 state!

  DMAC_CTRL_DMAENABLE DMAC_CTRL ! ;

: dma-channel-start ( ch)
  DMAC_CHID c!
  %10 DMAC_CHCTRLA cset! ;

: main
  -irq
  -1 state!
  base-clock-init
  -2 state!
  peripheral-clock-init
  -3 state!
  led-ports-init
  -4 state!
  pmux-init
  -5 state!
  5 GCLK_GENCTRL_SRC_DFLL source-gclk
  -6 state!
  nvic-init
  -7 state!
  tcc0-init ( the single onboard neopixel is on TCC0, channel 2)
  ( tcc1-init ( the fibonacci strand of neopixels defaults to being on TCC0,
                channel 2. life is pain. luckily we can switch it to TCC1, channel 0)

  $00:00:0F:0F onboard-color !
  onboard-to-fb
  $4200 state!
  0 dma-channel-start
  0 tcc-start
  begin
    -irq
    $4201 state!
    dmac-ints @
    $4202 state!
    0 dmac-ints !
    +irq wfi
  again ;

DMAC_IRQ handler
label DMAC_IRQ'
  begin
    DMAC_INTPEND w lit ( everything we need for a while is within $1f reach)
     4  w  x ldr  ( reads the DMAC_INTSTATUS register)
        x  x tst
    0= if lr bx then ( if there's none set, bail)
    >v dmac-ints y lit
    0   w  x ldr  ( now load the DMAC_INTPEND register)
        x  y mov  ( stash it in y so we can check the error bits later)
       $f  z movs
     z  x  x ands ( mask off the ID)
   $1f  w  x strb ( deposit the id in DMAC_CHID)
     8  y  y lsrs
     z  y  y ands ( mask off the error bits)
        0  z movs
     3  z  z subs
        z  y tst
    0!= if 1 bkpt then ( lockup if it's anything other than a transfer-complete interrupt)
    DMAC_CHINTFLAG w lit ( now load up the interrupt flag)
     0  w  x ldrb
  again ;c

HardFault_exc handler
label HardFault
  here b  ;c  ( rip)

NMI_exc handler default-handler
label Spurious
  2 bkpt  ;c ( lockup!)
pool,
