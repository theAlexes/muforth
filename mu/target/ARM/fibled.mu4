loading Fibonacci LED main program

__meta

variable state
variable tcc0-flags
variable onboard-color
variable onboard-bits-remaining

decimal

: state! ( a -- )
  state ! ;

ld! target/ARM/microchip/hardware-primitives.mu4
ld! target/ARM/microchip/samd21-clocks.mu4
ld! target/ARM/microchip/samd21-tcc.mu4

: led-ports-init
  32 0 do 0 i PORT_PINCFG0_0 + c! loop ( clear pin configs)
  [ 10 pin  ( MO pin to 128-LED strand)
    18 pin| ( neopixel pin)
    15 pin| ( neopixel power)
    16 pin| ( copy of neopixel pin from TCC0 channel 6)
    11 pin| ( gclk5 out, tapped from gclk0)
  #] dup PORT_DIRSET0 ! ( set these pins as outputs)
  PORT_OUTCLR0 ! ( turn everything off)
  [ 15 pin #] PORT_OUTSET0 ! ( turn neopixel power on) ;

: mux-pin ( func pin --)
  dup PORT_PINCFG0_0 + PORT_PINCFG0__PMUXEN swap c!
  2/ PORT_PMUX0_0 + cset! ;

: pmux-init
  PMUX_ODD_FUNCTION_H  11 mux-pin   ( pin PA11 to function H, GCLK channel 5)
  PMUX_EVEN_FUNCTION_F 16 mux-pin   ( pin PA16 to function F, TCC0 channel 6)
  PMUX_EVEN_FUNCTION_F 18 mux-pin   ( pin PA18 to function F, TCC0 channel 2)
  PMUX_EVEN_FUNCTION_E 10 mux-pin ; ( pin PA10 to function E, TCC1 channel 0)

: tcc0-handle ( flags)
  onboard-bits-remaining @ 0= if drop 0 tcc-stop ^ then
  dup 0= if ^ then
  onboard-color @ dup $0080:0000 and 0= if T0H else T1H then 0 tcc-next-bit
  1 << onboard-color !
  -1 onboard-bits-remaining +! ;

: main
  -irq
  -1 state!
  base-clock-init
  -2 state!
  peripheral-clock-init
  -3 state!
  led-ports-init
  -4 state!
  pmux-init
  -5 state!
  5 GCLK_GENCTRL_SRC_DFLL source-gclk
  -6 state!
  nvic-init
  -7 state!
  tcc0-init ( the single onboard neopixel is on TCC0, channel 2)
  ( tcc1-init ( the fibonacci strand of neopixels defaults to being on TCC0,
                channel 2. life is pain. luckily we can switch it to TCC1, channel 0)

  -1 tcc0-flags !
  $00:00:0F:0F onboard-color !
  23 onboard-bits-remaining !
  $4200 state!
  0 tcc-start
  begin
    -irq
    $4201 state!
    tcc0-flags @ tcc0-handle
    $4202 state!
    0 tcc0-flags !
    +irq wfi
  again ;

TCC0_IRQ handler
label TCC0_IRQ'
  TCC_INTFLAG w lit ( addr of int flag to w)
  0 w x ldr         ( int flag to x)
  >v tcc0-flags y lit ( addr of tcc0-flags to y)
  0 y x str         ( int flag to y)
  0 w x str         ( clear our interrupt)
  lr bx  ;c

HardFault_exc handler
  here b  ;c  ( rip)

NMI_exc handler default-handler
  lr bx  ;c  ( thank you, next)
pool,
