loading TCC driver

2 equ TCC_WAVE_WAVEGEN_NPWM

599 equ TCC_NEOPIXEL_PERIOD ( 600 ticks at 48 mhz is 800 kilohertz, but we start from 0)

( neopixel constants)
191 equ T0H ( 192 ticks is a 32% duty cycle)
383 equ T1H ( 384, 64%)

__meta target
: (tcc) ( a t -- a t') 10 << or ;

: tcc-sync ( tcc -- )
  TCC_SYNCBUSY swap (tcc) -1 ?clr ;

: tcc-period ( period tcc -- )
  TCC_PER swap (tcc) ! ;

: tcc-to-ccb ( tcc - ccbX)
  dup 0= if drop TCC_CCB2 else TCC_CCB0 swap (tcc) then ;

: tcc-next-bit ( bit tcc)
  tcc-to-ccb ! ;

: tcc-set! ( flag reg instance)
  dup >r (tcc) set! r> tcc-sync ;

: tcc-clr! ( flag reg instance)
  dup >r (tcc) clr! r> tcc-sync ;

: (tcc-neopixel-init) ( tcc -- )
  >r
  PM_APBCMASK_TCC0_ r@ << PM_APBCMASK set! ( thankfully, theyre contiguous bits)
  TCC_CTRLA_ENABLE TCC_CTRLA r@ tcc-clr!
  $10 state!

  TCC_CTRLA_SWRST TCC_CTRLA r@ tcc-set!
  $11 state!

  TCC_WAVE_WAVEGEN_NPWM TCC_WAVE r@ tcc-set!
  $12 state!

  0 r@ tcc-next-bit ( technically redundant as we have just reset the damn thing, but let's be sure anyway.)
  $13 state!

  TCC_INTENSET_OVF TCC_INTENSET r@ tcc-set!
  $14 state!

  TCC_NEOPIXEL_PERIOD r> tcc-period ;

: tcc-start ( tcc --)
  TCC_CTRLA_ENABLE TCC_CTRLA rot tcc-set! ;

: tcc-stop ( tcc -- )
  TCC_CTRLA_ENABLE TCC_CTRLA rot tcc-clr! ;

( tcc0 and tcc1 have similar init routines...)
: tcc0-init
  0 (tcc-neopixel-init)
  TCC0_IRQ nvic-enable-irq ;

: tcc1-init
  1 (tcc-neopixel-init)
  TCC1_IRQ nvic-enable-irq ;
