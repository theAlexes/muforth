loading Hardware primitives

__meta target

code +irq  cpsie  begin begin next  ;c
code -irq  cpsid        again  ;c
code wfi   cpsie wfi    again  ;c

: vec>int ( v -- i )
  2/ 2/ $10 - ;

: >bit ( v -- m )
  1 swap << ;

: nvic-enable-irq ( vector -- )
  vec>int >bit NVIC_ISER ! ;

: nvic-init
  -1 dup NVIC_ICER !
         NVIC_ICPR !
  8 0 do NVIC_IPR0 i cells + 0 swap ! loop ;

: 2drop  drop drop ;

: ?set   ( reg bits)   begin  over @   over and     until  2drop ;
: ?clr   ( reg bits)   begin  over @   over and  0= until  2drop ;
: ?cset  ( reg bits)   begin  over c@  over and     until  2drop ;
: ?cclr  ( reg bits)   begin  over c@  over and  0= until  2drop ;
